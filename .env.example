# Platform root domain (no scheme; port ok for dev). Tenants live at
# {handle}.{ROOT}. Locally, demo.localhost:3000 resolves without /etc/hosts.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Neon Postgres (Vercel Marketplace). Unset -> the app serves the demo seed.
DATABASE_URL=

# Auth.js + Sign in with Apple (created in the Apple Developer portal by the
# owner, never committed). AUTH_SECRET can be any random string
# (openssl rand -base64 32); it is also required for the dev login below.
AUTH_SECRET=
AUTH_APPLE_ID=
# Preferred production Apple credential. The app mints a fresh client secret
# from this key material on every server cold start.
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
# Optional static fallback. Leave unset when the key material above is present.
AUTH_APPLE_SECRET=

# Google OAuth web client.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic links. Use the texttext.app mailbox and sender only.
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM="Texttext <noreply@texttext.app>"

# Dev-only email login for local end-to-end testing without Apple. Set to 1 in
# development only; it is force-disabled whenever NODE_ENV=production, so it can
# never ship enabled.
AUTH_DEV_LOGIN=

# Vercel Blob (media uploads: covers and figures). Unset -> upload is disabled.
BLOB_READ_WRITE_TOKEN=
