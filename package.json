{
  "name": "texttext",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "not ie <= 11"
  ],
  "scripts": {
    "dev": "tsx scripts/work-unit.ts doctor --prune && next dev",
    "mac:dev": "mac/scripts/dev-run.sh",
    "mac:build": "swift build --package-path mac",
    "mac:test": "swift test --package-path mac",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "ship": "release/ship.sh",
    "testflight:prepare": "release/prepare-testflight-install.sh",
    "testflight:prepare:test": "release/test-prepare-testflight-install.sh",
    "health:review": "node scripts/review-app-health.mjs",
    "work:start": "tsx scripts/work-unit.ts begin",
    "work:doctor": "tsx scripts/work-unit.ts doctor",
    "work:summary": "tsx scripts/work-unit.ts summary",
    "work:finish": "tsx scripts/work-unit.ts finish",
    "verify:release": "tsx scripts/verify-release.ts",
    "verify:agent-integrations": "node scripts/verify-agent-integrations.mjs",
    "verify:workflows": "node --env-file=.env.local --import tsx scripts/verify-workflow-live.ts",
    "eval:sync:live": "node --env-file=.env.local --import tsx scripts/verify-sync-live.ts",
    "eval:clients:live": "node --env-file=.env.local --import tsx scripts/verify-local-live.ts",
    "showcase:templates": "tsx scripts/template-showcase.ts",
    "eval:collaboration:live": "node --env-file=.env.local --import tsx scripts/verify-collaboration-database.ts",
    "eval:collaboration:browser": "node --env-file=.env.local --import tsx scripts/verify-collaboration-browsers.ts",
    "test": "vitest run",
    "db:push": "node scripts/migrate-unified-documents.mjs && node scripts/migrate-enforce-canonical-documents.mjs && node scripts/migrate-add-slug-history.mjs && drizzle-kit push && node scripts/migrate-add-slug-history.mjs && node scripts/migrate-add-file-representation.mjs && node scripts/migrate-add-tags.mjs && node scripts/migrate-add-app-health.mjs && node scripts/migrate-add-oauth-token-lifecycle.mjs && node scripts/migrate-add-item-comments.mjs && node scripts/migrate-add-workspace-ai-config.mjs && node scripts/migrate-unified-documents.mjs && node scripts/migrate-enforce-canonical-documents.mjs && npx tsx scripts/audit-canonical-documents.ts",
    "eval:looks": "node --import tsx scripts/eval-look-authoring.ts",
    "eval:sidebar": "node --env-file=.env.local --import tsx scripts/eval-sidebar-looks.ts",
    "try": "mac/scripts/try.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.15",
    "@ai-sdk/openai": "^4.0.16",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.5.0",
    "ai": "^7.0.29",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
