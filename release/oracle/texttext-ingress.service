[Unit]
Description=Shared Oracle HTTPS routing for TextText and PartyParty
After=network-online.target pporigin.service texttext-https.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=LD_LIBRARY_PATH=/home/ubuntu/texttext/ingress/usr/lib/aarch64-linux-gnu
ExecStart=/home/ubuntu/texttext/ingress/usr/sbin/haproxy -W -db -f /etc/texttext/haproxy.cfg
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
